# Public URL of the deployed website, without a trailing slash.
# Used for SEO metadata (canonical URLs, social previews), sitemap.xml and robots.txt.
# On GitHub Pages the deploy workflow fills it in automatically; set the repository variable
# SITE_URL (Settings → Secrets and variables → Actions → Variables) to override it, e.g. for a custom domain.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Sub-folder the site is served from, e.g. /my-repo for https://user.github.io/my-repo.
# Leave empty for a custom domain or for local development. Set automatically by the deploy workflow.
NEXT_PUBLIC_BASE_PATH=

# Optional: Google Search Console "HTML tag" verification code (only the content="..." value).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
